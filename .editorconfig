# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs.
# https://editorconfig.org

# Source: https://chatgpt.com/c/6a778fe9-92c4-83ed-92d8-3b15c8ec1a43

root = true

# Global defaults
# 2-space indentation covers modern Web (HTML/CSS/JS), JSON, XML, RDF, OWL, Turtle, etc.
# C++, Java, and C# conventions as per
# https://google.github.io/styleguide/
#   cppguide.html#Spaces_vs._Tabs
#   javaguide.html#s4.2-block-indentation
#   csharp-style.html#whitespace-rules
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PEP 8 recommends 4 spaces per indentation level
[*.py]
indent_size = 4

# Match gofmt: tabs for indentation, rendered at 8-column tab stops
[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

# YAML parser syntax strictly forbids tab characters
[*.{yml,yaml}]
indent_style = space

# Conventional Make recipe lines use tabs
# Caveat: GNU Make normally requires a tab at the beginning of recipe lines, but .RECIPEPREFIX can deliberately change that character
[Makefile]
indent_style = tab
indent_size = tab

# Use native Windows line endings for cmd.exe batch scripts
[*.{bat,cmd}]
end_of_line = crlf

[{core,extended,iso-31073,iso-iec11179-3,reference-data}/*.owl]
trim_trailing_whitespace = false
