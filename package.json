{
  "name": "universal-ontology",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/universal-ontology-mcp-server"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "npm run fix:all",
    "build": "vite build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"vite.config.mjs\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/universal-ontology-mcp-server/**/*.{json,md}\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/universal-ontology-mcp-server/**/*.{json,md}\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"vite.config.mjs\" --fix && npm run format",
    "generate:jsonld": "node scripts/generateJsonLd.js --missing-only",
    "generate:jsonld:all": "node scripts/generateJsonLd.js",
    "mcp:index": "node scripts/generateOntologyQueryIndexes.js",
    "mcp:channel:stage": "node scripts/stageOntologyQueryArtifactChannel.js",
    "mcp:serve": "node scripts/runLocalOntologyMcpServer.js",
    "mcp:stdio": "node scripts/runUniversalOntologyMcpStdioServer.js",
    "mcp:dev": "node scripts/runLocalOntologyMcpServer.js --refresh-index",
    "mcp:package:build": "node scripts/distribution/buildUniversalOntologyMcpApplicationBundle.js",
    "mcp:package:pack": "npm pack --workspace universal-ontology-mcp-server --pack-destination dist/releases",
    "mcp:archives:build": "node scripts/distribution/buildUniversalOntologyMcpPlatformArchive.js",
    "mcp:sbom:create": "node scripts/distribution/createUniversalOntologyMcpSpdxSbom.js",
    "mcp:release:verify": "node scripts/distribution/verifyUniversalOntologyMcpRelease.js",
    "deploy": "python scripts/upload_to_s3.py",
    "deploy:force": "python scripts/upload_to_s3.py --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "@rdfjs/serializer-ntriples": "^2.0.1",
    "@rubensworks/saxes": "^ 6.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "html-validate": "^11.5.6",
    "jest": "^30.4.2",
    "jsonld": "^9.0.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rdf-canonize": "^5.0.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tar": "7.5.22",
    "terser": "^5.49.0",
    "vite": "^8.1.5",
    "vite-plugin-static-copy": "^4.1.1",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  }
}
