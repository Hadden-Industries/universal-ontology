{
  "name": "universal-ontology",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/universal-ontology-mcp-server",
    "packages/universal-ontology-query",
    "packages/universal-ontology-projection-policy"
  ],
  "type": "module",
  "scripts": {
    "set-up:development": "node scripts/setUpDevelopmentEnvironment.js",
    "set-up:agent-skills": "node scripts/runRepositoryPython.js scripts/set_up_agent_skills.py",
    "set-up:mcp-servers": "node scripts/runRepositoryPython.js scripts/set_up_mcp_servers.py",
    "test:python": "node scripts/runRepositoryPython.js scripts/runTestsInParallel.py",
    "test:python:serial": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_*.py",
    "test:ontology-policy": "node scripts/runRepositoryPython.js scripts/runTestsInParallel.py --pattern test_ontology_*.py",
    "test:policy-rendering": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_editing_policy_*.py -v",
    "configure:git-hooks": "node scripts/configureGitHooks.js",
    "validate:ontologies": "node scripts/runRepositoryPython.js scripts/validate_ontologies.py",
    "generate:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py",
    "check:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py --check",
    "build": "vite build",
    "build:verify": "node node_modules/vite/bin/vite.js build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js packages/universal-ontology-projection-policy packages/universal-ontology-query --runInBand",
    "test:consumer": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=\"/node_modules/\" \"<rootDir>/.sdlc/runtime/\" \"pr-check-scopes\" \"tests/build\" \"tests/distribution\"",
    "check:qualification": "npm test && npm run test:python && npm run lint && npm run format:check && npm run build:verify",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/*/package.json\" \"packages/*/*.md\" \"packages/*/src/**/*.{js,json}\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"packages/*/data/*.json\" \"server.json\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/*/package.json\" \"packages/*/*.md\" \"packages/*/src/**/*.{js,json}\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"packages/*/data/*.json\" \"server.json\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\" --fix && npm run format",
    "fix:code-style": "npm run fix:all",
    "generate:json-ld": "node scripts/generateJsonLd.js --missing-only",
    "generate:json-ld:all": "node scripts/generateJsonLd.js",
    "generate:ontology-indexes": "node scripts/generateOntologyQueryIndexes.js",
    "stage:ontology-artifacts": "node scripts/stageOntologyQueryArtifactChannel.js",
    "serve:mcp-development": "node scripts/runOntologyMcpDevelopment.js",
    "serve:mcp-stdio": "node packages/universal-ontology-mcp-server/scripts/runUniversalOntologyMcpStdioServer.js",
    "serve:mcp-development:refresh": "node scripts/runOntologyMcpDevelopment.js --refresh-index",
    "build:mcp-package": "npm run build --workspace universal-ontology-mcp-server",
    "pack:mcp-package": "npm pack --workspace universal-ontology-mcp-server --pack-destination dist/releases",
    "build:mcp-platform-archives": "node scripts/distribution/buildUniversalOntologyMcpPlatformArchive.js",
    "generate:mcp-sbom": "node scripts/distribution/createUniversalOntologyMcpSpdxSbom.js",
    "verify:mcp-release": "node scripts/distribution/verifyUniversalOntologyMcpRelease.js",
    "publish:website": "node scripts/runRepositoryPython.js scripts/upload_to_s3.py",
    "publish:website:force": "node scripts/runRepositoryPython.js scripts/upload_to_s3.py --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "@rdfjs/serializer-ntriples": "^2.0.1",
    "@rubensworks/saxes": "^ 6.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "jest": "^30.5.1",
    "jsonld": "^9.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "rdf-canonize": "^5.0.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "skills": "1.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tar": "7.5.22",
    "terser": "^5.51.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "universal-ontology-projection-policy": "1.0.0",
    "universal-ontology-query": "1.0.0",
    "zod": "4.6.5"
  }
}
