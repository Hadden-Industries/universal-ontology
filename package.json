{
  "name": "universal-ontology",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/universal-ontology-mcp-server",
    "packages/universal-ontology-query",
    "packages/universal-ontology-projection-policy"
  ],
  "type": "module",
  "scripts": {
    "setup:development": "node scripts/setUpDevelopmentEnvironment.js",
    "setup:sdlc": "node scripts/runRepositoryPython.js scripts/set_up_sdlc.py",
    "setup:skills": "node scripts/runRepositoryPython.js scripts/set_up_agent_skills.py --agent codex --local-only",
    "setup:mcp": "node scripts/runRepositoryPython.js scripts/set_up_mcp_servers.py",
    "setup:sdlc:github": "node scripts/runRepositoryPython.js scripts/bootstrap_github_sdlc.py",
    "sdlc": "node scripts/runRepositoryPython.js scripts/sdlc.py",
    "check:sdlc": "node scripts/runRepositoryPython.js scripts/set_up_sdlc.py --check",
    "test:sdlc": "node scripts/runRepositoryPython.js -m unittest discover -s tests/sdlc -v",
    "test:python": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_*.py",
    "test:ontology-policy": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_ontology_*.py -v",
    "test:policy-rendering": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_editing_policy_*.py -v",
    "configure:git-hooks": "node scripts/configureGitHooks.js",
    "validate:ontologies": "node scripts/runRepositoryPython.js scripts/validate_ontologies.py",
    "generate:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py",
    "check:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py --check",
    "prebuild": "npm run fix:all",
    "build": "vite build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/*/package.json\" \"packages/*/*.md\" \"packages/*/src/**/*.{js,json}\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"packages/*/data/*.json\" \"server.json\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"package.json\" \"packages/*/package.json\" \"packages/*/*.md\" \"packages/*/src/**/*.{js,json}\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"packages/*/data/*.json\" \"server.json\" \"scripts/distribution/*.json\" \"docs/mcp/*.md\"",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\" --fix && npm run format",
    "generate:jsonld": "node scripts/generateJsonLd.js --missing-only",
    "generate:jsonld:all": "node scripts/generateJsonLd.js",
    "mcp:index": "node scripts/generateOntologyQueryIndexes.js",
    "mcp:channel:stage": "node scripts/stageOntologyQueryArtifactChannel.js",
    "mcp:serve": "node scripts/runOntologyMcpDevelopment.js",
    "mcp:stdio": "node packages/universal-ontology-mcp-server/scripts/runUniversalOntologyMcpStdioServer.js",
    "mcp:dev": "node scripts/runOntologyMcpDevelopment.js --refresh-index",
    "mcp:package:build": "npm run build --workspace universal-ontology-mcp-server",
    "mcp:package:pack": "npm pack --workspace universal-ontology-mcp-server --pack-destination dist/releases",
    "mcp:archives:build": "node scripts/distribution/buildUniversalOntologyMcpPlatformArchive.js",
    "mcp:sbom:create": "node scripts/distribution/createUniversalOntologyMcpSpdxSbom.js",
    "mcp:release:verify": "node scripts/distribution/verifyUniversalOntologyMcpRelease.js",
    "deploy": "python scripts/upload_to_s3.py",
    "deploy:force": "python scripts/upload_to_s3.py --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "@rdfjs/serializer-ntriples": "^2.0.1",
    "@rubensworks/saxes": "^ 6.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "html-validate": "^11.15.0",
    "jest": "^30.5.1",
    "jsonld": "^9.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "rdf-canonize": "^5.0.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "skills": "1.5.26",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tar": "7.5.22",
    "terser": "^5.51.2",
    "vite": "^8.1.5",
    "vite-plugin-static-copy": "^4.1.1",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "universal-ontology-projection-policy": "1.0.0",
    "universal-ontology-query": "1.0.0",
    "zod": "4.5.4"
  }
}
