{
  "name": "universal-ontology",
  "version": "1.0.0",
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/universal-ontology-mcp-server",
    "packages/universal-ontology-query",
    "packages/universal-ontology-projection-policy"
  ],
  "type": "module",
  "scripts": {
    "set-up:development": "node scripts/setUpDevelopmentEnvironment.js",
    "plan:skill-reconciliation": "node scripts/runRepositoryPython.js tools/repository-skills.pyz plan",
    "apply:skill-reconciliation-plan": "node scripts/runRepositoryPython.js tools/repository-skills.pyz apply",
    "set-up:mcp-servers": "node scripts/runRepositoryPython.js scripts/set_up_mcp_servers.py",
    "test:python": "node scripts/runRepositoryPython.js scripts/runTestsInParallel.py",
    "test:python:serial": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_*.py",
    "test:ontology-policy": "node scripts/runRepositoryPython.js scripts/runTestsInParallel.py --pattern test_ontology_*.py",
    "test:policy-rendering": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_editing_policy_*.py -v",
    "configure:git-hooks": "node scripts/configureGitHooks.js",
    "validate:ontologies": "node scripts/runRepositoryPython.js scripts/validate_ontologies.py",
    "generate:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py",
    "check:editing-policy": "node scripts/runRepositoryPython.js scripts/render_editing_policy.py --check",
    "build": "vite build",
    "build:verify": "node node_modules/vite/bin/vite.js build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:node": "npm test -- --runInBand --testPathIgnorePatterns=\"/node_modules/|/.sdlc/runtime/\"",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js packages/universal-ontology-projection-policy packages/universal-ontology-query --runInBand",
    "test:consumer": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=\"/node_modules/\" \"<rootDir>/.sdlc/runtime/\" \"pr-check-scopes\" \"tests/build\" \"tests/distribution\"",
    "check:qualification": "npm run lint && npm run format:node:check && npm run format:python:check && npm test -- --runInBand && npm run test:python && node scripts/runRepositoryPython.js -I -B tools/repository-skills.pyz check && npm run build:verify && npm run check:json:generated",
    "lint": "npm run check:markdown && npm run lint:node && npm run lint:python && npm run check:json",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\" \"tooling/json/*.mjs\"",
    "format": "npm run format:json && npm run format:node && npm run format:python && npm run format:markdown",
    "format:check": "npm run format:json:check && npm run format:node:check && npm run format:python:check && npm run check:markdown",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"vite.config.mjs\" --fix && npm run lint:python:fix && npm run format",
    "fix:code-style": "npm run fix:all",
    "generate:json-ld": "node scripts/generateJsonLd.js --missing-only",
    "generate:json-ld:all": "node scripts/generateJsonLd.js",
    "generate:full-ontologies": "node scripts/createFullVersions.js",
    "generate:ontology-indexes": "node scripts/generateOntologyQueryIndexes.js",
    "stage:ontology-artifacts": "node scripts/stageOntologyQueryArtifactChannel.js",
    "serve:mcp-development": "node scripts/runOntologyMcpDevelopment.js",
    "serve:mcp-stdio": "node packages/universal-ontology-mcp-server/scripts/runUniversalOntologyMcpStdioServer.js",
    "serve:mcp-development:refresh": "node scripts/runOntologyMcpDevelopment.js --refresh-index",
    "build:mcp-package": "npm run build --workspace universal-ontology-mcp-server",
    "pack:mcp-package": "npm pack --workspace universal-ontology-mcp-server --pack-destination dist/releases",
    "build:mcp-platform-archives": "node scripts/distribution/buildUniversalOntologyMcpPlatformArchive.js",
    "generate:mcp-sbom": "node scripts/distribution/createUniversalOntologyMcpSpdxSbom.js",
    "verify:mcp-release": "node scripts/distribution/verifyUniversalOntologyMcpRelease.js",
    "publish:website": "node scripts/runRepositoryPython.js scripts/upload_to_s3.py",
    "publish:website:force": "node scripts/runRepositoryPython.js scripts/upload_to_s3.py --force",
    "format:node": "npm run format:node:files -- --write",
    "format:node:check": "npm run format:node:files -- --check",
    "format:node:files": "prettier \"src/**/*.{js,css,html}\" \"scripts/**/*.{js,mjs}\" \"templates/**/*.html\" \"tests/**/*.js\" \"vite.config.mjs\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.js\" \"packages/*/tests/**/*.js\" \"tooling/json/*.mjs\"",
    "lint:node": "npm run lint:html && npm run lint:css && npm run lint:js",
    "format:python": "node scripts/runRepositoryPython.js -I -m ruff format .",
    "format:python:check": "node scripts/runRepositoryPython.js -I -m ruff format --check .",
    "lint:python": "node scripts/runRepositoryPython.js -I -m ruff check .",
    "lint:python:fix": "node scripts/runRepositoryPython.js -I -m ruff check --fix .",
    "check:style": "npm run check:markdown && npm run lint:python && npm run format:python:check",
    "install:markdown": "node scripts/installRepositoryQualityTools.mjs markdown",
    "check:markdown": "npm --prefix tooling/markdown run check --",
    "format:markdown": "npm --prefix tooling/markdown run format --",
    "inspect:markdown": "npm --prefix tooling/markdown run inspect --",
    "qualify:markdown": "npm --prefix tooling/markdown run qualify --",
    "format:json:check": "node scripts/runRepositoryJsonQuality.js check",
    "check:json": "node scripts/runRepositoryJsonQuality.js check",
    "check:json:generated": "npm run check:json -- --require-generated",
    "format:json": "node scripts/runRepositoryJsonQuality.js format",
    "normalize:json": "node scripts/runRepositoryJsonQuality.js normalize",
    "install:json": "node scripts/installRepositoryQualityTools.mjs json",
    "inspect:json": "node scripts/runRepositoryJsonQuality.js check --json"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1",
    "@humanwhocodes/momoa": ">=3.3.13",
    "@jest/globals": ">=30.5.2",
    "@modelcontextprotocol/client": ">=2.3.1",
    "@rdfjs/serializer-jsonld-ext": ">=4.0.2",
    "@rdfjs/serializer-ntriples": ">=2.0.1",
    "@rubensworks/saxes": ">=6.0.1",
    "@xmldom/xmldom": ">=0.9.12",
    "ajv": ">=8.20.0",
    "ajv-formats": ">=3.0.1",
    "braces": "file:vendor/braces",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.1.8",
    "globals": ">=17.13.0",
    "html-validate": ">=11.16.2",
    "jest": ">=30.5.2",
    "jsonld": ">=9.0.0",
    "owlapi": "git+https://github.com/Hadden-Industries/owlapi.git#e15320d6438b27c5aaa7aa9302b6919749873ec9",
    "oxigraph": ">=0.5.11",
    "playwright": ">=1.64.0",
    "prettier": ">=3.9.10",
    "rdf-canonize": ">=5.0.0",
    "rdfxml-streaming-parser": ">=3.3.0",
    "stylelint": ">=17.16.0",
    "stylelint-config-clean-order": ">=10.0.0",
    "stylelint-config-standard": ">=40.0.0",
    "stylelint-order": ">=8.1.1",
    "tar": ">=7.5.22",
    "terser": ">=5.51.2",
    "vite": ">=8.3.3",
    "vite-plugin-static-copy": ">=4.1.1",
    "yaml": ">=2.9.1",
    "yauzl": ">=3.4.0",
    "yazl": ">=3.3.1"
  },
  "overrides": {
    "braces": "file:vendor/braces",
    "@istanbuljs/load-nyc-config@1.1.0": {
      "js-yaml": "4.3.2"
    }
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "universal-ontology-projection-policy": ">=1.0.0",
    "universal-ontology-query": ">=1.0.0",
    "zod": ">=4.6.5"
  }
}
