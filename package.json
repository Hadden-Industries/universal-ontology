{
  "name": "universal-ontology",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "fix:all": "stylelint \"src/**/*.css\" --fix && eslint \"src/**/*.js\" --fix && prettier --write \"src/**/*.{js,css,html}\"",
    "generate:jsonld": "node scripts/generateJsonLd.js --missing-only",
    "generate:jsonld:all": "node scripts/generateJsonLd.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rdfjs/serializer-jsonld-ext": "^4.0.2",
    "@rdfjs/serializer-ntriples": "^2.0.1",
    "@rubensworks/saxes": "^ 6.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "html-validate": "^11.5.6",
    "jest": "^30.4.2",
    "jsonld": "^9.0.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rdf-canonize": "^5.0.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1"
  },
  "license": "MIT",
  "private": true
}
