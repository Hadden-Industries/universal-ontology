#!/bin/sh
set -eu

readonly ONTOLOGY_VALIDATOR_PATH="scripts/validate_ontologies.py"

if [ ! -f "${ONTOLOGY_VALIDATOR_PATH}" ]; then
    printf 'Ontology validation script is missing: %s\n' "${ONTOLOGY_VALIDATOR_PATH}" >&2
    exit 1
fi

if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON_EXECUTABLE_PATH=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PYTHON_EXECUTABLE_PATH=".venv/bin/python"
else
    printf '%s\n' 'A Python interpreter is required in .venv. Run npm run setup:development before committing.' >&2
    exit 1
fi
readonly PYTHON_EXECUTABLE_PATH

exec "${PYTHON_EXECUTABLE_PATH}" "${ONTOLOGY_VALIDATOR_PATH}" --staged --python-exec "${PYTHON_EXECUTABLE_PATH}"
