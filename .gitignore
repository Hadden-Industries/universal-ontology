# Universal Ontology Exclusions
src/**/latest
src/**/latest-unstable
dist/

# Environment Exclusions
.env
.venv/
__pycache__/
*.pyc

# Node.js dependencies
node_modules/

# Repository-local agent tool installations
/.agent-tools/

# Repository configuration transaction artifacts (may retain sensitive input)
/.mcp.json.repository-setup.*.staged.tmp
/.mcp.json.repository-setup.*.activation.backup
/.codex/**/.*.repository-setup.*.staged.tmp
/.codex/**/.*.repository-setup.*.activation.backup
/.agents/.mcp_config.json.repository-setup.*.staged.tmp
/.agents/.mcp_config.json.repository-setup.*.activation.backup

# Local SDLC evidence and owned scratch; neither is publication evidence
/.sdlc/runtime/
/.sdlc/tmp/

# Machine-local MCP host configuration
/.agents/mcp_config.json

# Local Agent Skills
.agents/skills/
.claude/skills/
