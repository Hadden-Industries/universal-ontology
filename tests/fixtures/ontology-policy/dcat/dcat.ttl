# DCAT dataset and distribution profile cases. The fixture module owns the real
# dataset/ and distribution/ namespaces (see dcat.expected.json).
@prefix ds:      <https://haddenindustries.com/ontology/dataset/> .
@prefix di:      <https://haddenindustries.com/ontology/distribution/> .
@prefix ex:      <https://example.org/fixtures/entity/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ; owl:versionIRI ex:20260101 ; owl:versionInfo "2026-01-01" .
ex:Statistics a owl:Class ; rdfs:label "Statistics"@en .

# --- Datasets ---------------------------------------------------------------

# Fully valid dataset with two distributions, a landing page and one access right.
ds:0f6b2a9c-3d4e-4f50-8a6b-7c8d9e0f1a2b a owl:NamedIndividual , dcat:Dataset ;
    dcat:theme ex:Statistics ;
    dcterms:title "Population estimates"@en ;
    dcterms:description "Annual population estimates"@en , "Estimations annuelles"@fr ;
    rdfs:label "Population estimates"@en ;
    dcat:distribution di:1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d , di:2b3c4d5e-6f70-4b8c-9d0e-1f2a3b4c5d6e ;
    dcat:landingPage <https://example.org/provider/population> , <https://example.org/provider/population-2> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> .

