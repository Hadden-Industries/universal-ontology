{
  "schemaVersion": 2,
  "preset": "authored-gfm@1",
  "include": [
    "**/*.md"
  ],
  "exclude": [
    ".agents/skills/**",
    ".claude/skills/**",
    ".agent-tools/**",
    "dist/**",
    "docs/sdlc/*",
    "docs/reviews/*",
    "docs/research/**",
    "vendor/*",
    "docs/policy/Editing-Policy.generated.md",
    "docs/policy/Editing-Policy.sidebar.md"
  ],
  "lint": {},
  "links": {
    "localFiles": true,
    "rootRelative": "reject"
  },
  "layout": {
    "endOfLine": "lf",
    "tabWidth": 2
  }
}
