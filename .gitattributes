# Repository-wide line ending enforcement (supersedes local core.autocrlf)
# - Auto-detect text vs binary files
# - Normalise text files to LF on commit and keep LF on checkout
* text=auto eol=lf

# Preserve files exactly as supplied/generated
src/external/** -text !eol
dist/**         -text !eol

# Authority payloads are retained byte-exact for their recorded hashes: no EOL or whitespace normalisation.
policy/authorities/raw/* -text -whitespace
