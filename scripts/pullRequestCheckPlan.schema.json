{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageMode",
    "mode",
    "revision",
    "comparisonBase",
    "scopes",
    "requiredJobs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "packageMode": {
      "enum": ["disabled", "ci", "manual"]
    },
    "mode": {
      "enum": ["changed", "full"]
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "comparisonBase": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_tooling",
        "python_style",
        "python_tests",
        "python_setup_tests",
        "documentation",
        "ontology_validation",
        "ontology_validation_workflow",
        "ontology_entity_contracts",
        "ontology_policy_qa",
        "ontology_qualification",
        "agent_skills_lock",
        "development",
        "product_tests",
        "ci_control",
        "mcp_artifacts",
        "website_build",
        "mcp_docs",
        "mcp_application",
        "mcp_release_qualification"
      ],
      "properties": {
        "style_tooling": {
          "type": "boolean"
        },
        "python_style": {
          "type": "boolean"
        },
        "python_tests": {
          "type": "boolean"
        },
        "python_setup_tests": {
          "type": "boolean"
        },
        "documentation": {
          "type": "boolean"
        },
        "ontology_validation": {
          "type": "boolean"
        },
        "ontology_validation_workflow": {
          "type": "boolean"
        },
        "ontology_entity_contracts": {
          "type": "boolean"
        },
        "ontology_policy_qa": {
          "type": "boolean"
        },
        "ontology_qualification": {
          "type": "boolean"
        },
        "agent_skills_lock": {
          "type": "boolean"
        },
        "development": {
          "type": "boolean"
        },
        "product_tests": {
          "type": "boolean"
        },
        "ci_control": {
          "type": "boolean"
        },
        "mcp_artifacts": {
          "type": "boolean"
        },
        "website_build": {
          "type": "boolean"
        },
        "mcp_docs": {
          "type": "boolean"
        },
        "mcp_application": {
          "type": "boolean"
        },
        "mcp_release_qualification": {
          "type": "boolean"
        }
      }
    },
    "requiredJobs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["development", "ontology", "node", "website", "distribution"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "changed"
          }
        }
      },
      "then": {
        "properties": {
          "comparisonBase": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      },
      "else": {
        "properties": {
          "comparisonBase": {
            "type": "null"
          },
          "scopes": {
            "properties": {
              "style_tooling": {
                "const": true
              },
              "python_style": {
                "const": true
              },
              "python_tests": {
                "const": true
              },
              "python_setup_tests": {
                "const": true
              },
              "documentation": {
                "const": true
              },
              "ontology_validation": {
                "const": true
              },
              "ontology_validation_workflow": {
                "const": true
              },
              "ontology_entity_contracts": {
                "const": true
              },
              "ontology_policy_qa": {
                "const": true
              },
              "ontology_qualification": {
                "const": true
              },
              "agent_skills_lock": {
                "const": true
              },
              "development": {
                "const": true
              },
              "product_tests": {
                "const": true
              },
              "ci_control": {
                "const": true
              },
              "website_build": {
                "const": true
              },
              "mcp_docs": {
                "const": true
              },
              "mcp_application": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packageMode": {
            "const": "disabled"
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_artifacts": {
                "const": false
              },
              "mcp_release_qualification": {
                "const": false
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packageMode": {
            "const": "manual"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "full"
          },
          "scopes": {
            "properties": {
              "mcp_artifacts": {
                "const": true
              },
              "mcp_release_qualification": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packageMode": {
            "const": "ci"
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_release_qualification": {
                "const": false
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packageMode": {
            "const": "ci"
          },
          "mode": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_artifacts": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_artifacts": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_application": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_release_qualification": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "properties": {
              "mcp_artifacts": {
                "const": true
              }
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
